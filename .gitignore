# Logs and debug files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*
.pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
backups/


# Dependencies and package managers
node_modules/
.pnp
.pnp.*
.npm/
.pnpm-store/
.yarn-integrity

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build and compiled output
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Test coverage and instrumentation
coverage/
.nyc_output/
lib-cov/
.grunt/

# Package archives and native modules
*.tgz
.lock-wscript

# Caches
.firebase/
.dataconnect/
.eslintcache
.eslintcache*
.node_repl_history

# Environment variables
# Keep secrets out of version control.
# Commit only sanitized example environment files.
.env*
!.env.local.example

# Firebase configuration
# Uncomment the following line if each developer should configure
# their own Firebase project instead of sharing .firebaserc.
# .firebaserc

# Firebase Admin SDK service account keys
*firebase-adminsdk*.json
*-adminsdk-*.json
service-account*.json

# IDE and editor files
.vscode/
.idea/

# Deployment platforms
.vercel/

# Operating system files
.DS_Store
Thumbs.db

# Certificates and private keys
*.pem

# Legacy dependency directories
bower_components/